{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Storythread Studio",
    "version":  "2.0.5",
    "identifier":  "studio.storythread.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Storythread Studio",
                                    "width":  1536,
                                    "height":  864,
                                    "minWidth":  1024,
                                    "minHeight":  700,
                                    "center":  true,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/storythread-backend"
                                   ],
                   "resources":  [

                                 ]
               },
    "plugins":  {
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://github.com/StoryThread-Dean/StorythreadStudio/releases/latest/download/latest.json"
                                                  ],
                                    "dialog":  false,
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwN0JENzY0RkM4OTBFMjkKUldRcERvbjhaTmQ3b0lneVJ4b1FUU3pWN1FSZ2IwV1FyaUhjbVIzY0tsUFIybldzcVpFNDFrL3kK"
                                }
                }
}
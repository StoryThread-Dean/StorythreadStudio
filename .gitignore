# ── Python Backend ────────────────────────────────────────────────────────────
# .venv is the virtual environment uv creates -- contains all Python packages.
# Never commit this: it's large, machine-specific, and reproducible via uv sync.
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.ruff_cache/

# ── Frontend / Node ───────────────────────────────────────────────────────────
# node_modules contains all npm packages -- reproducible via npm install.
app/node_modules/
app/dist/
app/dist-ssr/
*/local

# ── Kokoro worker (local narration engine) ───────────────────────────────────
# The worker's venv is reproducible via uv sync. The model files (~340MB)
# are downloaded from the kokoro-onnx releases -- never committed; the
# packaged build ships them inside the kokoro-worker artifact instead.
kokoro-worker/.venv/
kokoro-worker/models/
kokoro-worker/__pycache__/
kokoro-worker/build/
kokoro-worker/dist/

# ── Tauri / Rust ──────────────────────────────────────────────────────────────
# Rust build artifacts -- large and fully reproducible via cargo build.
app/src-tauri/target/

# ── Backend bundling ──────────────────────────────────────────────────────────
# PyInstaller intermediates: build/ and dist/ are throwaway, regenerated
# every release. scripts/build-backend.ps1 copies the real .exe into
# app/src-tauri/binaries/ where Tauri picks it up.
backend/build/
backend/dist/

# Real PyInstaller-built sidecar binaries are 40-80 MB and reproducible.
# We DO commit the zero-byte placeholder named below (so dev mode compiles
# without requiring everyone to run build-backend first), but any larger
# .exe in that folder is a build artifact and should NOT be committed.
# Use `git add -f` if you ever need to override this.
app/src-tauri/binaries/*-*.exe.bak

# ── Release artifacts ────────────────────────────────────────────────────────
# scripts/release.ps1 stages .msi, .sig, latest.json here before manual
# upload to GitHub Releases. Nothing here belongs in git.
release-artifacts/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets (never commit these) ──────────────────────────────────────────────
# The user's OpenRouter API key will be stored here locally.
.env
.env.local
*.env

# ── Storythread Studio Writing Projects ──────────────────────────────────────
# The .storythread folder inside each writing project holds the SQLite database,
# cache files, and logs. These are generated at runtime, not source code.
**/.storythread/
.claude/

# ── Local developer reference material (not source) ──────────────────────────
# .test-files/ holds local screenshots and scratch files used for planning
# (UI mockups the writer drags in, etc). chapter_summary_ai_instructions.md
# is the writer's private prompt draft -- the authoritative copy lives inside
# backend/app/ai/prompts.py as CHAPTER_SUMMARY_INSTRUCTIONS.
.test-files/
chapter_summary_ai_instructions.md
.claude/settings.local.json

# local/ holds private planning drafts (spec drafts, notes) that stay on this
# machine. Finalized documents graduate into docs/ (e.g. the audiobook
# converter spec). Note: the earlier */local pattern only matches one level
# deep, so the repo-root local/ needs its own entry.
local/
